# OpenAI API配置
OPENAI_API_KEY=your_openai_api_key_here

# RAG 向量数据库路径（相对于项目根目录）
# RAG_VECTOR_STORE_PATH=../数据/data_index
# 不配置远程题库或向量库时，自动使用仓库附带的 JSON 题库。
# 显式配置 JSON 时优先使用它（相对路径以 backend 为基准）：
# QUESTION_JSON_PATH=../../data/第一轮仔细清洗/interview_questions_categorized.json

# 数据库配置
DATABASE_TYPE=sqlite
SQLITE_DB_PATH=../data/interviews.db

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=../data/logs/interview.log

# 服务配置
API_HOST=0.0.0.0
API_PORT=8000

# Supabase 配置（题库来源）
# 仅使用 Supabase 时取消注释，并填写真实项目地址和密钥。
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your_supabase_service_key
# SUPABASE_TABLE=interview_questions

# 默认跳过启动时的外部连通性探测；不会跳过所选题库的实际加载。
SKIP_STARTUP_TESTS=1
